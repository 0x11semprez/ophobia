#!/bin/sh
# Runs the CI checks locally and blocks the push if any fails.
set -e
echo "pre-push: running CI checks"
test -z "$(gofmt -l .)" || { echo "pre-push: gofmt needed:"; gofmt -l .; exit 1; }
go vet ./...
go test -race ./...
go run golang.org/x/vuln/cmd/govulncheck@latest ./...
go build ./...
echo "pre-push: all checks passed"
